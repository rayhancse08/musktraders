generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitChoice {
  gm
  kg
  lb
  ounce
  pcs
  pound
  box
  ml
}

enum DiscountType {
  percentage
  flat
}

enum SaleStatus {
  confirmed
  packing
  delivering
  delivered
  cancelled
}

enum WarehouseCostType {
  rent
  salary
  utility
  maintenance
  insurance
  equipment
  transport
  other
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("brands")
}

model ProductCategory {
  id         Int       @id @default(autoincrement())
  name       String
  image      String?
  isFeatured Boolean   @default(false) @map("is_featured")
  slug       String?   @unique
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id                    Int          @id @default(autoincrement())
  name                  String?
  slug                  String?      @unique
  image                 String?
  thumbnail             String?
  brandId               Int?         @map("brand_id")
  categoryId            Int?         @map("category_id")
  packetPerCarton       Int?         @map("packet_per_carton")
  weight                Decimal      @default(0) @db.Decimal(12, 4)
  unit                  UnitChoice   @default(pcs)
  stockedQuantity       Int?         @map("stocked_quantity")
  stockedPacketQuantity Int?         @map("stocked_packet_quantity")
  purchasePrice         Decimal?     @map("purchase_price") @db.Decimal(12, 4)
  salePrice             Decimal?     @map("sale_price") @db.Decimal(12, 4)
  packetPrice           Decimal?     @map("packet_price") @db.Decimal(12, 4)
  discountType          DiscountType @default(percentage) @map("discount_type")
  discount              Decimal?     @db.Decimal(12, 4)
  discountPrice         Decimal?     @map("discount_price") @db.Decimal(12, 4)
  description           String?
  manualEntry           Boolean      @default(false) @map("manual_entry")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  brand          Brand?           @relation(fields: [brandId], references: [id])
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  warehouseItems WarehouseItem[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  returnProducts ReturnProduct[]
  damageProducts DamageProduct[]

  @@map("products")
}

model WarehouseItem {
  id                      Int       @id @default(autoincrement())
  productId               Int       @map("product_id")
  lotNumber               String?   @map("lot_number")
  productPrice            Decimal?  @map("product_price") @db.Decimal(12, 4)
  cartonHandlingCost      Decimal?  @map("carton_handling_cost") @db.Decimal(12, 4)
  purchasedPrice          Decimal?  @map("purchased_price") @db.Decimal(12, 4)
  profitPercentage        Decimal?  @map("profit_percentage") @db.Decimal(12, 4)
  salePrice               Decimal?  @map("sale_price") @db.Decimal(12, 4)
  stockedQuantity         Int?      @map("stocked_quantity")
  damagedQuantity         Int?      @map("damaged_quantity")
  saleQuantity            Int?      @map("sale_quantity")
  salePacketQuantity      Int?      @map("sale_packet_quantity")
  remainingQuantity       Int?      @map("remaining_quantity")
  remainingPacketQuantity Int?      @map("remaining_packet_quantity")
  returnQuantity          Int?      @map("return_quantity")
  manualRemainingQuantity Int?      @map("manual_remaining_quantity")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("warehouse_items")
}

model Store {
  id           Int          @id @default(autoincrement())
  name         String
  city         String?
  phoneNumber  String?      @map("phone_number")
  email        String?
  address      String?
  discountType DiscountType @default(percentage) @map("discount_type")
  discount     Decimal?     @db.Decimal(12, 4)
  taxId        String?      @map("tax_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  sales Sale[]

  @@map("stores")
}

model Vendor {
  id          Int       @id @default(autoincrement())
  name        String
  phoneNumber String?   @map("phone_number")
  email       String?
  address     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  purchases Purchase[]

  @@map("vendors")
}

model BillingCompany {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sales Sale[]

  @@map("billing_companies")
}

model Purchase {
  id                       Int       @id @default(autoincrement())
  lotNumber                String    @map("lot_number")
  date                     DateTime? @db.Date
  receiveDate              DateTime? @map("receive_date") @db.Date
  vendorId                 Int?      @map("vendor_id")
  shippingCost             Decimal   @default(0) @map("shipping_cost") @db.Decimal(12, 4)
  foodQualityControlCost   Decimal   @default(0) @map("food_quality_control_cost") @db.Decimal(12, 4)
  containerClearingCost    Decimal   @default(0) @map("container_clearing_cost") @db.Decimal(12, 4)
  loryShippingCost         Decimal   @default(0) @map("lory_shipping_cost") @db.Decimal(12, 4)
  labourerHandlingCost     Decimal   @default(0) @map("labourer_handling_cost") @db.Decimal(12, 4)
  warehouseRent            Decimal   @default(0) @map("warehouse_rent") @db.Decimal(12, 4)
  employeeSalary           Decimal   @default(0) @map("employee_salary") @db.Decimal(12, 4)
  warehouseOtherCost       Decimal   @default(0) @map("warehouse_other_cost") @db.Decimal(12, 4)
  profitMargin             Decimal?  @map("profit_margin") @db.Decimal(12, 4)
  cartonHandlingCost       Decimal   @default(0) @map("carton_handling_cost") @db.Decimal(12, 4)
  lcInformation            String?   @map("lc_information")
  bilInformation           String?   @map("bil_information")
  containerInformation     String?   @map("container_information")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  vendor           Vendor?            @relation(fields: [vendorId], references: [id])
  purchaseItems    PurchaseItem[]
  purchasePayments PurchasePayment[]

  @@map("purchases")
}

model PurchaseItem {
  id                Int      @id @default(autoincrement())
  purchaseId        Int      @map("purchase_id")
  productId         Int      @map("product_id")
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 4)
  purchasedCarton   Int      @map("purchased_carton")
  receivedCarton    Int?     @map("received_carton")
  damagedCarton     Int?     @map("damaged_carton")
  profitPercentage  Decimal? @map("profit_percentage") @db.Decimal(12, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model PurchasePayment {
  id                 Int       @id @default(autoincrement())
  purchaseId         Int       @map("purchase_id")
  amount             Decimal   @db.Decimal(12, 4)
  date               DateTime  @db.Date
  accountInformation String?   @map("account_information")
  note               String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_payments")
}

model Sale {
  id               Int          @id @default(autoincrement())
  orderNo          String       @unique @map("order_no")
  date             DateTime     @db.Date
  deliveryDate     DateTime?    @map("delivery_date") @db.Date
  status           SaleStatus   @default(confirmed)
  storeId          Int          @map("store_id")
  billingCompanyId Int?         @map("billing_company_id")
  shippingCharge   Decimal      @default(0) @map("shipping_charge") @db.Decimal(12, 4)
  discountType     DiscountType @default(flat) @map("discount_type")
  discountAmount   Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 4)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  store          Store           @relation(fields: [storeId], references: [id])
  billingCompany BillingCompany? @relation(fields: [billingCompanyId], references: [id])
  saleItems      SaleItem[]
  salePayments   SalePayment[]

  @@map("sales")
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int      @map("sale_id")
  productId Int      @map("product_id")
  quantity  Int
  price     Decimal  @db.Decimal(12, 4)
  packetPrice Decimal @map("packet_price") @db.Decimal(12, 4)
  discount  Decimal  @default(0) @db.Decimal(12, 4)
  lotInformation String? @map("lot_information")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model SalePayment {
  id                 Int       @id @default(autoincrement())
  saleId             Int       @map("sale_id")
  amount             Decimal   @db.Decimal(12, 4)
  date               DateTime  @db.Date
  accountInformation String?   @map("account_information")
  note               String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

model ReturnProduct {
  id        Int       @id @default(autoincrement())
  date      DateTime  @db.Date
  productId Int       @map("product_id")
  lotNumber String?   @map("lot_number")
  quantity  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("return_products")
}

model DamageProduct {
  id        Int       @id @default(autoincrement())
  date      DateTime  @db.Date
  productId Int       @map("product_id")
  quantity  Int
  price     Decimal?  @db.Decimal(12, 4)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("damage_products")
}

model TaxCategory {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  taxItems TaxItem[]

  @@map("tax_categories")
}

model TaxCompany {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  monthlyTaxFiles   MonthlyTaxFile[]
  monthlyCashInFiles MonthlyCashInFile[]

  @@map("tax_companies")
}

model MonthlyTaxFile {
  id        Int       @id @default(autoincrement())
  year      Int
  month     Int
  companyId Int?      @map("company_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company  TaxCompany? @relation(fields: [companyId], references: [id])
  taxItems TaxItem[]

  @@unique([year, month, companyId])
  @@map("monthly_tax_files")
}

model TaxItem {
  id            Int       @id @default(autoincrement())
  monthFileId   Int       @map("month_file_id")
  taxCategoryId Int       @map("tax_category_id")
  date          DateTime? @db.Date
  amount        Decimal?  @db.Decimal(12, 4)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  monthFile   MonthlyTaxFile @relation(fields: [monthFileId], references: [id], onDelete: Cascade)
  taxCategory TaxCategory    @relation(fields: [taxCategoryId], references: [id])

  @@map("tax_items")
}

model CashInCategory {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  cashInItems CashInItem[]

  @@map("cash_in_categories")
}

model MonthlyCashInFile {
  id        Int       @id @default(autoincrement())
  year      Int
  month     Int
  companyId Int?      @map("company_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company     TaxCompany?  @relation(fields: [companyId], references: [id])
  cashInItems CashInItem[]

  @@unique([year, month, companyId])
  @@map("monthly_cash_in_files")
}

model CashInItem {
  id               Int       @id @default(autoincrement())
  monthFileId      Int       @map("month_file_id")
  cashInCategoryId Int?      @map("cash_in_category_id")
  date             DateTime? @db.Date
  amount           Decimal?  @db.Decimal(12, 4)
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  monthFile      MonthlyCashInFile @relation(fields: [monthFileId], references: [id], onDelete: Cascade)
  cashInCategory CashInCategory?   @relation(fields: [cashInCategoryId], references: [id])

  @@map("cash_in_items")
}

model MonthlyWarehouseCost {
  id        Int       @id @default(autoincrement())
  year      Int
  month     Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items WarehouseCostItem[]

  @@unique([year, month])
  @@map("monthly_warehouse_costs")
}

model WarehouseCostItem {
  id        Int               @id @default(autoincrement())
  monthId   Int               @map("month_id")
  costType  WarehouseCostType @map("cost_type")
  date      DateTime?         @db.Date
  amount    Decimal?          @db.Decimal(12, 4)
  notes     String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")

  month MonthlyWarehouseCost @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@map("warehouse_cost_items")
}

model MonthlyPlan {
  id          Int       @id @default(autoincrement())
  year        Int
  month       Int
  salesTarget Decimal?  @map("sales_target") @db.Decimal(12, 4)
  budget      Decimal?  @db.Decimal(12, 4)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([year, month])
  @@map("monthly_plans")
}

model YearlyPlan {
  id          Int       @id @default(autoincrement())
  year        Int       @unique
  salesTarget Decimal?  @map("sales_target") @db.Decimal(12, 4)
  budget      Decimal?  @db.Decimal(12, 4)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("yearly_plans")
}

model MonthlyReport {
  id                   Int       @id @default(autoincrement())
  year                 Int
  month                Int
  purchase             Decimal?  @db.Decimal(12, 4)
  warehouseCost        Decimal?  @map("warehouse_cost") @db.Decimal(12, 4)
  sale                 Decimal?  @db.Decimal(12, 4)
  damageProduct        Decimal?  @map("damage_product") @db.Decimal(12, 4)
  profit               Decimal?  @db.Decimal(12, 4)
  salePaidPayment      Decimal?  @map("sale_paid_payment") @db.Decimal(12, 4)
  saleDuePayment       Decimal?  @map("sale_due_payment") @db.Decimal(12, 4)
  purchasePaidPayment  Decimal?  @map("purchase_paid_payment") @db.Decimal(12, 4)
  purchaseDuePayment   Decimal?  @map("purchase_due_payment") @db.Decimal(12, 4)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  @@unique([year, month])
  @@map("monthly_reports")
}

model YearlyReport {
  id                   Int       @id @default(autoincrement())
  year                 Int       @unique
  purchaseAmount       Decimal?  @map("purchase_amount") @db.Decimal(12, 4)
  warehouseCostAmount  Decimal?  @map("warehouse_cost_amount") @db.Decimal(12, 4)
  saleAmount           Decimal?  @map("sale_amount") @db.Decimal(12, 4)
  paymentSendAmount    Decimal?  @map("payment_send_amount") @db.Decimal(12, 4)
  paymentReceiveAmount Decimal?  @map("payment_receive_amount") @db.Decimal(12, 4)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  @@map("yearly_reports")
}
