{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: install + dev (recommended)",
      "type": "shell",
      "command": "bash scripts/setup.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Next.js",
          "endsPattern": "(Ready in|Local:.*http://localhost:3000|started server)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "close": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "dev: npm run dev",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
